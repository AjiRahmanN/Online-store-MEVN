# Server
PORT=3500

# Database
DATABASE_URI=mongodb://127.0.0.1:27017/ecomeers

# JWT
ACCESS_TOKEN_SECRET=ganti-dengan-string-acak-panjang
REFRESH_TOKEN_SECRET=ganti-dengan-string-acak-panjang-lainnya

# Midtrans (Sandbox) - ambil dari Midtrans Dashboard > Settings > Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
